# Optional API keys for trip-planner. Every key is optional; leave a line empty to skip it.
#
# The scripts read environment variables, not this file. Copy it to .env (which git ignores), fill in
# the keys you have, then load them into your environment: the README's "Optional API Keys" section
# shows how. Never paste a key into a chat with the agent.

# Live and historic traffic (developer.tomtom.com; free tier 20,000 requests a month, no card)
TOMTOM_API_KEY=

# Ontario highway closures and collisions on the route (511on.ca/developers/help; free account)
ON511_API_KEY=

# EV charger searches beyond the shared demo key (developer.nlr.gov; free key, 1,000 calls an hour)
NLR_API_KEY=

# Parking rates quoted in Google reviews, shown as unverified leads (Places API (New); needs billing)
GOOGLE_PLACES_API_KEY=
